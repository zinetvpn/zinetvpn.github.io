---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="صفحه پیدا نشد"
  description="آدرس واردشده در مرکز آموزش زی‌نت پیدا نشد."
  canonicalPath="/404/"
  noindex={true}
>
  <section class="not-found container">
    <p class="eyebrow">خطای ۴۰۴</p>
    <h1>این صفحه پیدا نشد</h1>
    <p>ممکن است نشانی تغییر کرده باشد. از صفحه اصلی، راهنمای مناسب را انتخاب کنید.</p>
    <a class="button" href="/">
      بازگشت به صفحه اصلی
    </a>
  </section>
</BaseLayout>
